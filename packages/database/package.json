{
  "name": "@repo/database",
  "version": "0.0.0",
  "main": "./index.ts",
  "types": "./index.ts",
  "exports": {
    ".": "./index.ts",
    "./types": "./types.ts",
    "./server": "./clients/server.ts",
    "./browser": "./clients/browser.ts",
    "./admin": "./clients/admin.ts",
    "./keys": "./keys.ts"
  },
  "scripts": {
    "clean": "git clean -xdf .cache .turbo dist node_modules",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:migration": "supabase migration new",
    "db:types": "supabase gen types typescript --local > types.generated.ts"
  },
  "dependencies": {
    "@supabase/ssr": "^0.7.0",
    "@supabase/supabase-js": "^2.48.1",
    "@t3-oss/env-nextjs": "^0.13.10",
    "server-only": "^0.0.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@repo/typescript-config": "workspace:*",
    "@types/node": "25.3.5",
    "next": "16.1.6",
    "supabase": "^2.20.0",
    "typescript": "^5.9.3"
  }
}
